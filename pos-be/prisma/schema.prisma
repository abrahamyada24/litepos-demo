generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  CASHIER
}

enum AuthClientType {
  WEB
  ANDROID
}

enum LicensePlan {
  TRIAL
  PREMIUM
}

enum LicenseState {
  ACTIVE
  SUSPENDED
}

enum TransactionStatus {
  PENDING
  PAID
  CANCELLED
  COMPLETED
  RETURNED
}

enum PaymentType {
  CASH
  QRIS
  QRIS_MANUAL
  TRANSFER
}

enum StockMovementType {
  IN
  OUT
}

enum StockMovementSource {
  SALE
  PURCHASE
  ADJUSTMENT
  RETURN
}

enum ShiftStatus {
  OPEN
  CLOSED
}

enum OrderType {
  DINE_IN
  TAKE_AWAY
  PRE_ORDER
}

enum StoreType {
  RETAIL
  LAUNDRY
}

enum WorkStatus {
  RECEIVED
  PROCESSING
  READY
  PICKED_UP
}

model Store {
  id           Int       @id @default(autoincrement())
  slug         String    @unique @db.VarChar(80)
  name         String    @db.VarChar(255)
  type         StoreType @default(RETAIL)
  isActive     Boolean   @default(true) @map("is_active")
  isPublicDemo Boolean   @default(false) @map("is_public_demo")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  memberships       StoreMembership[]
  activeSessions    AuthSession[]      @relation("ActiveStoreSessions")
  licenses          StoreLicense[]
  categories        Category[]
  products          Product[]
  customers         Customer[]
  transactions      Transaction[]
  stockMovements    StockMovement[]
  settings          StoreSetting?
  loyaltyConfig     LoyaltyConfig?
  expenses          Expense[]
  shifts            Shift[]
  savedTransactions SavedTransaction[]
  stockReceipts     StockReceipt[]
  productAddons     ProductAddon[]
  dineTables        DineTable[]
  packages          Package[]
  suppliers         Supplier[]

  @@map("stores")
}

model StoreMembership {
  userId    Int      @map("user_id")
  storeId   Int      @map("store_id")
  role      Role     @default(CASHIER)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([userId, storeId])
  @@index([storeId, isActive])
  @@map("store_memberships")
}

model User {
  id                  Int       @id @default(autoincrement())
  name                String    @db.VarChar(255)
  email               String    @unique @db.VarChar(255)
  username            String?   @unique @db.VarChar(50)
  password            String    @db.VarChar(255)
  role                Role      @default(CASHIER)
  imageUrl            String?   @map("image_url") @db.Text
  isActive            Boolean   @default(true) @map("is_active")
  mustChangePassword  Boolean   @default(false) @map("must_change_password")
  passwordChangedAt   DateTime? @map("password_changed_at")
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")
  lastLoginAt         DateTime? @map("last_login_at")

  otpCode      String?   @map("otp_code") @db.VarChar(6)
  otpExpiresAt DateTime? @map("otp_expires_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  transactions      Transaction[]
  savedTransactions SavedTransaction[]
  authSessions      AuthSession[]
  storeMemberships  StoreMembership[]

  @@map("users")
}

model AuthSession {
  id            String         @id @default(uuid())
  jwtId         String         @unique @map("jwt_id") @db.VarChar(64)
  userId        Int            @map("user_id")
  activeStoreId Int?           @map("active_store_id")
  clientType    AuthClientType @default(WEB) @map("client_type")
  deviceName    String?        @map("device_name") @db.VarChar(150)
  ipHash        String?        @map("ip_hash") @db.VarChar(64)
  userAgent     String?        @map("user_agent") @db.VarChar(255)
  createdAt     DateTime       @default(now()) @map("created_at")
  lastSeenAt    DateTime       @default(now()) @map("last_seen_at")
  expiresAt     DateTime       @map("expires_at")
  revokedAt     DateTime?      @map("revoked_at")
  revokeReason  String?        @map("revoke_reason") @db.VarChar(100)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeStore   Store?         @relation("ActiveStoreSessions", fields: [activeStoreId], references: [id], onDelete: SetNull)

  @@index([userId, revokedAt])
  @@index([activeStoreId])
  @@index([lastSeenAt])
  @@map("auth_sessions")
}

model StoreLicense {
  id                    Int                 @id @default(autoincrement())
  storeId               Int                 @unique @map("store_id")
  licenseNumber         String              @unique @map("license_number") @db.VarChar(40)
  plan                  LicensePlan         @default(TRIAL)
  state                 LicenseState        @default(ACTIVE)
  startsAt              DateTime            @default(now()) @map("starts_at")
  expiresAt             DateTime?           @map("expires_at")
  activatedAt           DateTime?           @map("activated_at")
  activationSource      String              @default("AUTO_TRIAL") @map("activation_source") @db.VarChar(40)
  legacyStoreId         String?             @map("legacy_store_id") @db.VarChar(100)
  offlineGraceDays      Int                 @default(7) @map("offline_grace_days")
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")
  activationRedemptions LicenseActivation[]
  store                 Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("store_licenses")
}

model LicenseActivation {
  id              String        @id @default(uuid())
  codeHash        String        @unique @map("code_hash") @db.VarChar(64)
  plan            LicensePlan   @default(PREMIUM)
  durationDays    Int           @map("duration_days")
  validUntil      DateTime?     @map("valid_until")
  note            String?       @db.VarChar(255)
  createdAt       DateTime      @default(now()) @map("created_at")
  redeemedAt      DateTime?     @map("redeemed_at")
  redeemedByEmail String?       @map("redeemed_by_email") @db.VarChar(255)
  licenseId       Int?          @map("license_id")
  license         StoreLicense? @relation(fields: [licenseId], references: [id])

  @@index([redeemedAt])
  @@map("license_activations")
}

// Akun pengelola platform sengaja dipisahkan dari User/StoreMembership.
// Dengan begitu role OWNER/ADMIN milik tenant tidak pernah memperoleh akses platform.
model PlatformAdmin {
  id          Int                    @id @default(autoincrement())
  name        String                 @db.VarChar(255)
  email       String                 @unique @db.VarChar(255)
  password    String                 @db.VarChar(255)
  isActive    Boolean                @default(true) @map("is_active")
  lastLoginAt DateTime?              @map("last_login_at")
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")
  sessions    PlatformAdminSession[]
  auditLogs   PlatformAuditLog[]

  @@map("platform_admins")
}

model PlatformAdminSession {
  id           String        @id @default(uuid())
  jwtId        String        @unique @map("jwt_id") @db.VarChar(64)
  adminId      Int           @map("admin_id")
  userAgent    String?       @map("user_agent") @db.VarChar(255)
  createdAt    DateTime      @default(now()) @map("created_at")
  lastSeenAt   DateTime      @default(now()) @map("last_seen_at")
  expiresAt    DateTime      @map("expires_at")
  revokedAt    DateTime?     @map("revoked_at")
  revokeReason String?       @map("revoke_reason") @db.VarChar(100)
  admin        PlatformAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId, revokedAt])
  @@index([lastSeenAt])
  @@map("platform_admin_sessions")
}

model PlatformAuditLog {
  id         String         @id @default(uuid())
  requestId  String?        @unique @map("request_id") @db.VarChar(100)
  adminId    Int?           @map("admin_id")
  action     String         @db.VarChar(80)
  targetType String         @map("target_type") @db.VarChar(60)
  targetId   String?        @map("target_id") @db.VarChar(100)
  details    String?        @db.Text
  createdAt  DateTime       @default(now()) @map("created_at")
  admin      PlatformAdmin? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([adminId, createdAt])
  @@index([targetType, targetId])
  @@map("platform_audit_logs")
}

model Category {
  id          Int       @id @default(autoincrement())
  storeId     Int       @map("store_id")
  androidId   Int?      @unique @map("android_id")
  name        String    @db.VarChar(100)
  imageUrl    String?   @map("image_url") @db.Text
  displayType String    @default("normal") @map("display_type")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  products    Product[]
  store       Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@map("categories")
}

model Product {
  id                Int       @id @default(autoincrement())
  storeId           Int       @map("store_id")
  androidId         Int?      @unique @map("android_id")
  categoryId        Int       @map("category_id")
  sku               String    @unique @db.VarChar(50)
  name              String    @db.VarChar(255)
  imageUrl          String?   @map("image_url") @db.Text
  barcode           String?   @db.VarChar(100)
  displayType       String    @default("normal") @map("display_type")
  price             Decimal   @db.Decimal(15, 2)
  costPrice         Decimal   @default(0) @map("cost_price") @db.Decimal(15, 2)
  stock             Int       @default(0)
  minStock          Int       @default(0) @map("min_stock")
  isActive          Boolean   @default(true) @map("is_active")
  isUnlimitedStock  Boolean   @default(false) @map("is_unlimited_stock")
  enableCostPrice   Boolean   @default(false) @map("enable_cost_price")
  discountActive    Boolean   @default(false) @map("discount_active")
  discountType      String?   @map("discount_type") @db.VarChar(20)
  discountValue     Decimal   @default(0) @map("discount_value") @db.Decimal(15, 2)
  discountStartAt   DateTime? @map("discount_start_at")
  discountEndAt     DateTime? @map("discount_end_at")
  discountStartTime String?   @map("discount_start_time") @db.VarChar(5)
  discountEndTime   String?   @map("discount_end_time") @db.VarChar(5)
  discountDays      String?   @map("discount_days") @db.VarChar(30)
  discountLabel     String?   @map("discount_label") @db.VarChar(100)
  unitLabel         String    @default("item") @map("unit_label") @db.VarChar(30)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  category          Category           @relation(fields: [categoryId], references: [id])
  store             Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  transactionItems  TransactionItem[]
  stockMovements    StockMovement[]
  stockReceiptItems StockReceiptItem[]
  addons            ProductAddon[]
  packageItems      PackageItem[]

  @@index([storeId])
  @@map("products")
}

model Customer {
  id              Int           @id @default(autoincrement())
  storeId         Int           @map("store_id")
  androidId       Int?          @unique @map("android_id")
  memberId        String        @unique @map("member_id") @db.VarChar(50)
  name            String        @db.VarChar(255)
  phone           String?       @unique @db.VarChar(20)
  email           String?       @db.VarChar(255)
  notes           String?       @db.Text
  imageUrl        String?       @map("image_url") @db.Text
  displayType     String        @default("normal") @map("display_type")
  loyaltyDiscount Decimal       @default(0) @map("loyalty_discount") @db.Decimal(5, 2)
  points          Int           @default(0) @map("points")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  transactions    Transaction[]
  store           Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@map("customers")
}

model Transaction {
  id                Int               @id @default(autoincrement())
  storeId           Int               @map("store_id")
  androidId         String?           @unique @map("android_id") @db.VarChar(100)
  shiftId           String?           @map("shift_id")
  userId            Int               @map("user_id")
  customerId        Int?              @map("customer_id")
  customerName      String?           @map("customer_name") @db.VarChar(255)
  invoiceNumber     String            @unique @map("invoice_number") @db.VarChar(50)
  subTotal          Decimal           @default(0) @map("sub_total") @db.Decimal(15, 2)
  taxAmount         Decimal           @default(0) @map("tax_amount") @db.Decimal(15, 2)
  discountAmount    Decimal           @default(0) @map("discount_amount") @db.Decimal(15, 2)
  pointsEarned      Int?              @map("points_earned")
  pointsRedeemed    Int?              @map("points_redeemed")
  pointsBalanceAfter Int?             @map("points_balance_after")
  loyaltyReversed   Boolean           @default(false) @map("loyalty_reversed")
  grandTotal        Decimal           @map("grand_total") @db.Decimal(15, 2)
  cashAmount        Decimal?          @map("cash_amount") @db.Decimal(15, 2)
  changeAmount      Decimal?          @map("change_amount") @db.Decimal(15, 2)
  status            TransactionStatus @default(PENDING)
  workStatus        WorkStatus?       @map("work_status")
  orderType         OrderType         @default(TAKE_AWAY) @map("order_type")
  tableNumber       String?           @map("table_number") @db.VarChar(20)
  note              String?           @db.Text
  preOrderDate      DateTime?         @map("pre_order_date")
  preOrderConfirmed Boolean           @default(false) @map("pre_order_confirmed")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  user              User              @relation(fields: [userId], references: [id])
  store             Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer          Customer?         @relation(fields: [customerId], references: [id])
  shift             Shift?            @relation(fields: [shiftId], references: [id])
  items             TransactionItem[]
  payments          Payment[]

  @@index([storeId, createdAt])
  @@index([shiftId, status])
  @@map("transactions")
}

model TransactionItem {
  id             Int         @id @default(autoincrement())
  transactionId  Int         @map("transaction_id")
  productId      Int         @map("product_id")
  qty            Int
  price          Decimal     @db.Decimal(15, 2)
  originalPrice  Decimal     @default(0) @map("original_price") @db.Decimal(15, 2)
  discountAmount Decimal     @default(0) @map("discount_amount") @db.Decimal(15, 2)
  costPrice      Decimal     @default(0) @map("cost_price") @db.Decimal(15, 2)
  notes          String?     @db.Text
  createdAt      DateTime    @default(now()) @map("created_at")
  transaction    Transaction @relation(fields: [transactionId], references: [id])
  product        Product     @relation(fields: [productId], references: [id])

  @@map("transaction_items")
}

model Payment {
  id            Int         @id @default(autoincrement())
  transactionId Int         @map("transaction_id")
  paymentType   PaymentType @map("payment_type")
  amount        Decimal     @db.Decimal(15, 2)
  referenceId   String?     @map("reference_id") @db.VarChar(255)
  paymentStatus String?     @map("payment_status") @db.VarChar(50)
  createdAt     DateTime    @default(now()) @map("created_at")
  transaction   Transaction @relation(fields: [transactionId], references: [id])

  @@map("payments")
}

model StockMovement {
  id          Int                 @id @default(autoincrement())
  storeId     Int                 @map("store_id")
  productId   Int                 @map("product_id")
  type        StockMovementType
  qty         Int
  source      StockMovementSource
  description String?             @db.Text
  createdAt   DateTime            @default(now()) @map("created_at")
  product     Product             @relation(fields: [productId], references: [id])
  store       Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, createdAt])
  @@map("stock_movements")
}

model StoreSetting {
  id                   Int       @id @default(autoincrement())
  storeId              Int       @unique @map("store_id")
  storeName            String    @default("My POS Store") @map("store_name")
  logoUrl              String?   @map("logo_url") @db.Text
  address              String?   @db.Text
  phone                String?   @db.VarChar(20)
  email                String?   @db.VarChar(255)
  website              String?   @db.VarChar(255)
  enableCash           Boolean   @default(true) @map("enable_cash")
  enableQris           Boolean   @default(false) @map("enable_qris")
  enableDebit          Boolean   @default(false) @map("enable_debit")
  taxRate              Decimal   @default(0) @map("tax_rate") @db.Decimal(5, 2)
  serviceCharge        Decimal   @default(0) @map("service_charge") @db.Decimal(5, 2)
  autoPrintReceipt     Boolean   @default(true) @map("auto_print_receipt")
  receiptFooter        String?   @map("receipt_footer") @db.Text
  enablePreOrder       Boolean   @default(false) @map("enable_pre_order")
  enableShift          Boolean   @default(true) @map("enable_shift")
  enableShiftReminder  Boolean   @default(true) @map("enable_shift_reminder")
  shiftDurationMinutes Int       @default(480) @map("shift_duration_minutes")
  shiftReminderMinutes Int       @default(15) @map("shift_reminder_minutes")
  shiftDayCutoff       String    @default("23:50") @map("shift_day_cutoff") @db.VarChar(5)
  enableDineTable      Boolean   @default(false) @map("enable_dine_table")
  takeawayOptions      String?   @map("takeaway_options") @db.Text
  allowNegativeStock   Boolean   @default(false) @map("allow_negative_stock")
  showImages           Boolean   @default(true) @map("show_images")
  theme                String    @default("light") @db.VarChar(20)
  dataResetVersion     Int       @default(0) @map("data_reset_version")
  dataResetInProgress  Boolean   @default(false) @map("data_reset_in_progress")
  dataResetAt          DateTime? @map("data_reset_at")
  dataResetBy          String?   @map("data_reset_by") @db.VarChar(255)
  updatedAt            DateTime  @updatedAt @map("updated_at")
  store                Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("store_settings")
}

model LoyaltyConfig {
  id                  Int      @id @default(autoincrement())
  storeId             Int      @unique @map("store_id")
  pointMultiplier     Decimal  @default(1) @map("point_multiplier") @db.Decimal(15, 2)
  multiplierAmount    Decimal  @default(10000) @map("multiplier_amount") @db.Decimal(15, 2)
  pointValue          Decimal  @default(100) @map("point_value") @db.Decimal(15, 2)
  minRedemptionPoints Int      @default(10) @map("min_redemption_points")
  isActive            Boolean  @default(true) @map("is_active")
  updatedAt           DateTime @updatedAt @map("updated_at")
  store               Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("loyalty_config")
}

// ── NEW MODELS (from PosAndroid) ─────────────────────────────────────────

model Expense {
  id          Int      @id @default(autoincrement())
  storeId     Int      @map("store_id")
  shiftId     String?  @map("shift_id")
  description String   @db.Text
  amount      Decimal  @db.Decimal(15, 2)
  category    String   @default("Umum") @db.VarChar(100)
  type        String   @default("EXPENSE") @db.VarChar(20)
  createdAt   DateTime @default(now()) @map("created_at")
  shift       Shift?   @relation(fields: [shiftId], references: [id])
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, createdAt])
  @@index([shiftId, createdAt])
  @@map("expenses")
}

model Shift {
  id              String        @id @default(uuid())
  storeId         Int           @map("store_id")
  userId          Int           @map("user_id")
  userName        String        @map("user_name") @db.VarChar(255)
  openedAt        DateTime      @map("opened_at")
  expectedCloseAt DateTime?     @map("expected_close_at")
  closedAt        DateTime?     @map("closed_at")
  openingCash     Decimal       @default(0) @map("opening_cash") @db.Decimal(15, 2)
  closingCash     Decimal?      @map("closing_cash") @db.Decimal(15, 2)
  status          ShiftStatus   @default(OPEN)
  transactions    Transaction[]
  expenses        Expense[]
  store           Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, status])
  @@map("shifts")
}

model SavedTransaction {
  id        String   @id @default(uuid())
  storeId   Int      @map("store_id")
  name      String   @db.VarChar(255)
  cartData  String   @map("cart_data") @db.LongText
  userId    Int      @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id])
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, createdAt])
  @@map("saved_transactions")
}

model StockReceipt {
  id         String             @id @default(uuid())
  storeId    Int                @map("store_id")
  receivedAt DateTime           @map("received_at")
  notes      String?            @db.Text
  createdBy  String?            @map("created_by") @db.VarChar(255)
  items      StockReceiptItem[]
  store      Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, receivedAt])
  @@map("stock_receipts")
}

model StockReceiptItem {
  id             Int          @id @default(autoincrement())
  receiptId      String       @map("receipt_id")
  productId      Int          @map("product_id")
  productName    String?      @map("product_name") @db.VarChar(255)
  quantityBefore Int          @default(0) @map("quantity_before")
  quantityAdded  Int          @map("quantity_added")
  costPrice      Decimal      @default(0) @map("cost_price") @db.Decimal(15, 2)
  receipt        StockReceipt @relation(fields: [receiptId], references: [id])
  product        Product      @relation(fields: [productId], references: [id])

  @@map("stock_receipt_items")
}

model ProductAddon {
  id        Int     @id @default(autoincrement())
  storeId   Int     @map("store_id")
  androidId Int?    @unique @map("android_id")
  productId Int     @map("product_id")
  name      String  @db.VarChar(255)
  price     Decimal @default(0) @db.Decimal(15, 2)
  product   Product @relation(fields: [productId], references: [id])
  store     Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, productId])
  @@map("product_addons")
}

model DineTable {
  id              Int       @id @default(autoincrement())
  storeId         Int       @map("store_id")
  androidId       Int?      @unique @map("android_id")
  number          String    @unique @db.VarChar(20)
  name            String?   @db.VarChar(100)
  capacity        Int       @default(4)
  status          String    @default("AVAILABLE") @db.VarChar(20)
  occupiedAt      DateTime? @map("occupied_at")
  statusUpdatedAt DateTime  @default(now()) @map("status_updated_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  store           Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@map("dine_tables")
}

model Package {
  id          Int           @id @default(autoincrement())
  storeId     Int           @map("store_id")
  androidId   Int?          @unique @map("android_id")
  name        String        @db.VarChar(255)
  description String?       @db.Text
  imageUrl    String?       @map("image_url") @db.Text
  price       Decimal       @db.Decimal(15, 2)
  isActive    Boolean       @default(true) @map("is_active")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  items       PackageItem[]
  store       Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@map("packages")
}

model PackageItem {
  id        Int @id @default(autoincrement())
  packageId Int @map("package_id")
  productId Int @map("product_id")
  qty       Int @default(1)

  package Package @relation(fields: [packageId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@map("package_items")
}

model Supplier {
  id        Int      @id @default(autoincrement())
  storeId   Int      @map("store_id")
  androidId Int?     @unique @map("android_id")
  name      String   @db.VarChar(255)
  phone     String?  @db.VarChar(20)
  address   String?  @db.Text
  notes     String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@map("suppliers")
}
